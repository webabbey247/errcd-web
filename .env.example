# Public site origin — used for metadataBase, canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://errcd.com

# --- Sanity ---
# Fully wired but DORMANT until NEXT_PUBLIC_SANITY_PROJECT_ID is set. Until then every
# page renders the bundled copy in src/content/. Setting the project id activates the
# CMS; run `npm run seed` first so the dataset matches the current live copy.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-01
SANITY_API_READ_TOKEN=            # viewer scope; required for Live + Presentation
# SANITY_API_WRITE_TOKEN=         # seed script only, never used at runtime
SANITY_REVALIDATE_SECRET=         # shared secret for the /api/revalidate webhook

# --- Analytics (CHECKLIST.md §5.1 — DEFERRED: site ships with no tracking) ---
# Uncomment only the line for whichever provider is eventually chosen.
# NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=   # free, cookieless, pageviews only
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=             # free self-hosted, custom events
# NEXT_PUBLIC_UMAMI_SRC=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=            # free, but requires a consent banner
